generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  LANDLORD
  TENANT
}

enum UnitStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum ChargeType {
  RENT
  LATE_FEE
  UTILITY
  REPAIR
  OTHER
}

enum ChargeStatus {
  DUE
  PARTIAL
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CHECK
  ZELLE
  VENMO
  BANK_TRANSFER
  OTHER
}

enum PaymentSource {
  MANUAL
  WEBHOOK
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  SCHEDULED
  COMPLETED
  CLOSED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  HVAC
  APPLIANCE
  STRUCTURAL
  PEST
  OTHER
}

enum MaintenanceFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  CUSTOM
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  IN_APP_ONLY
}

enum DeliveryChannel {
  SMS
  IN_APP
}

enum ExpenseCategory {
  REPAIRS
  MORTGAGE
  INSURANCE
  UTILITIES
  TAXES
  HOA
  LANDSCAPING
  CLEANING
  SUPPLIES
  OTHER
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(LANDLORD)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  properties   Property[]
  expenses     Expense[]
  mileageTrips            MileageTrip[]
  accounts                Account[]
  sessions                Session[]
  preventiveMaintenances  PreventiveMaintenance[]
  conversations           Conversation[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Property {
  id        String   @id @default(cuid())
  name      String
  address   String
  city      String
  state     String
  zipCode   String
  notes     String?
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  units                  Unit[]
  expenses               Expense[]
  mileageTrips           MileageTrip[]
  preventiveMaintenances PreventiveMaintenance[]

  @@index([ownerId])
}

model Unit {
  id         String     @id @default(cuid())
  unitNumber String
  bedrooms   Int
  bathrooms  Float
  sqft       Int?
  marketRent Decimal    @db.Decimal(10, 2)
  status     UnitStatus @default(VACANT)
  notes      String?
  propertyId String
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  leases                 Lease[]
  expenses               Expense[]
  maintenanceRequests    MaintenanceRequest[]
  preventiveMaintenances PreventiveMaintenance[]

  @@unique([propertyId, unitNumber])
  @@index([propertyId])
}

model Tenant {
  id        String    @id @default(cuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  notes     String?
  userId    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  leases              Lease[]
  payments            Payment[]
  maintenanceRequests MaintenanceRequest[]
  conversations       Conversation[]
}

model Lease {
  id              String      @id @default(cuid())
  status          LeaseStatus @default(DRAFT)
  startDate       DateTime
  endDate         DateTime
  rentAmount      Decimal     @db.Decimal(10, 2)
  securityDeposit Decimal     @default(0) @db.Decimal(10, 2)
  rentDueDay      Int         @default(1)
  documentPath    String?
  notes           String?
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId          String
  unit            Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  charges         Charge[]

  @@index([status])
  @@index([unitId])
  @@index([tenantId])
}

model Charge {
  id          String       @id @default(cuid())
  type        ChargeType
  status      ChargeStatus @default(DUE)
  description String
  amount      Decimal      @db.Decimal(10, 2)
  paidAmount  Decimal      @default(0) @db.Decimal(10, 2)
  dueDate     DateTime
  leaseId     String
  lease       Lease        @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  allocations PaymentAllocation[]

  @@index([status, dueDate])
  @@index([leaseId, status])
}

model Payment {
  id           String        @id @default(cuid())
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod
  receivedDate DateTime
  reference    String?
  notes        String?
  source       PaymentSource @default(MANUAL)
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  allocations  PaymentAllocation[]
}

model PaymentAllocation {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(10, 2)
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  chargeId  String
  charge    Charge   @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([paymentId, chargeId])
}

model Expense {
  id                  String          @id @default(cuid())
  date                DateTime
  amount              Decimal         @db.Decimal(10, 2)
  category            ExpenseCategory
  description         String
  vendor              String?
  propertyId          String?
  property            Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  unitId              String?
  unit                Unit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  paperlessDocumentId Int?
  notes               String?
  ownerId             String
  owner               User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([ownerId])
}

model MileageTrip {
  id         String    @id @default(cuid())
  date       DateTime
  miles      Float
  purpose    String
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  notes      String?
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([ownerId])
}

model Document {
  id          String   @id @default(cuid())
  filename    String
  storagePath String
  mimeType    String
  sizeBytes   Int
  category    String?
  entityType  String
  entityId    String
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
}

model MaintenanceRequest {
  id             String              @id @default(cuid())
  title          String
  description    String
  status         MaintenanceStatus   @default(OPEN)
  priority       MaintenancePriority @default(MEDIUM)
  category       MaintenanceCategory @default(OTHER)
  scheduledDate  DateTime?
  completedDate  DateTime?
  unitId         String
  unit           Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  comments       MaintenanceComment[]

  @@index([status])
  @@index([unitId])
}

model MaintenanceComment {
  id                   String             @id @default(cuid())
  text                 String
  authorId             String
  authorName           String
  authorRole           String
  maintenanceRequestId String
  maintenanceRequest   MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now())
}

model PreventiveMaintenance {
  id            String               @id @default(cuid())
  title         String
  description   String?
  frequency     MaintenanceFrequency
  customDays    Int?
  nextDueDate   DateTime
  lastCompleted DateTime?
  notifyTenants Boolean              @default(false)
  isActive      Boolean              @default(true)
  propertyId    String?
  property      Property?            @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  unitId        String?
  unit          Unit?                @relation(fields: [unitId], references: [id], onDelete: SetNull)
  ownerId       String
  owner         User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model Conversation {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  subject       String?
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  messages      Message[]

  @@unique([tenantId, ownerId])
  @@index([ownerId, lastMessageAt])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  channel        DeliveryChannel  @default(IN_APP)
  status         MessageStatus    @default(PENDING)
  body           String
  twilioSid      String?
  errorMessage   String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@index([conversationId, direction, readAt])
}
